    {
      "id": "enchantment-overrides",
      "title": "enchantmentOverrides",
      "intro": "Per-enchantment override system. Keys are enchantment IDs (e.g., <code class='text-accent2'>minecraft:sharpness</code> or <code class='text-accent2'>meridian:siphon</code>). Use <code class='text-accent2'>-1</code> for any field to keep the vanilla default.",
      "blocks": [
        {
          "type": "table",
          "bottomGap": true,
          "headers": ["Key", "Type", "Default", "Description"],
          "rows": [
            ["<code class='text-accent2 whitespace-nowrap'>enabled</code>", "boolean", "true", "Whether this enchantment can appear"],
            ["<code class='text-accent2 whitespace-nowrap'>maxLevel</code>", "int", "-1", "Override maximum level (1&ndash;127, or -1 for default)"],
            ["<code class='text-accent2 whitespace-nowrap'>maxLootLevel</code>", "int", "-1", "Clamp on the level granted by loot tables and trades (1&ndash;127); rolls above it are clamped down, and -1 leaves vanilla behavior untouched"],
            ["<code class='text-accent2 whitespace-nowrap'>levelCap</code>", "int", "-1", "Hard cap on level (1&ndash;127, or -1)"],
            ["<code class='text-accent2 whitespace-nowrap'>minPowerFunction</code>", "object", "null", "Custom min power function (see below)"],
            ["<code class='text-accent2 whitespace-nowrap'>maxPowerFunction</code>", "object", "null", "Custom max power function (see below)"]
          ]
        },
        {
          "type": "panel",
          "title": "Power Function Types",
          "items": [
            "<code class='text-accent2'>\"linear\"</code> &mdash; <code class='text-accent2'>base + perLevel * level</code>",
            "<code class='text-accent2'>\"fixed\"</code> &mdash; constant <code class='text-accent2'>value</code> regardless of level",
            "<code class='text-accent2'>\"default\"</code> &mdash; vanilla behavior"
          ]
        },
        { "type": "code", "small": true, "topGap": true, "code": "{\n  \"enchantmentOverrides\": {\n    \"minecraft:sharpness\": {\n      \"enabled\": true,\n      \"maxLevel\": 10,\n      \"maxLootLevel\": 5,\n      \"levelCap\": -1,\n      \"minPowerFunction\": {\n        \"type\": \"linear\",\n        \"base\": 1,\n        \"perLevel\": 11,\n        \"value\": 0\n      },\n      \"maxPowerFunction\": {\n        \"type\": \"linear\",\n        \"base\": 21,\n        \"perLevel\": 11,\n        \"value\": 0\n      }\n    },\n    \"meridian:excavate\": {\n      \"enabled\": false\n    }\n  }\n}" }
      ]
    },
