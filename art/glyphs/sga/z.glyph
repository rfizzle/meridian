# Standard Galactic Alphabet rune 'z' — canonical enchanting letterform.
# Top-lit glow ramp (H bright -> M mid -> D dim). Renders the fire variant
# standalone; render-sga.py recolors it into water/sculk/end.
size: 8
kind: sprite
ships: src/main/resources/assets/meridian/textures/particle/sga_z_fire.png

legend:
  . transparent
  H #ffe000            # bright core
  M #ffa300            # mid
  D #cd5600            # dim

grid:
  ..H.....
  .H.H....
  H...H...
  M...M...
  M...M...
  D...D...
  D...D...
  ........
