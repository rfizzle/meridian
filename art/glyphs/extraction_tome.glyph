# Meridian — extraction (salvage) tome. Shares the suite tome silhouette but
# reads as "extraction" at a glance: a rich royal-blue cover carrying a bright
# cyan crossed-bones salvage rune, with tan/brown page edges along the bottom.
size: 32

legend:
  . transparent
  K #000c1f            # darkest ink — outermost outline / cover deep shadow
  A #00163e            # dark blue outline
  B #001f56            # dark blue edge / page shadow
  C #002669            # mid-dark blue rim
  D #002c76            # blue mid
  E #002c7c            # blue mid (alt face shade)
  P #00348f            # royal-blue cover face
  y #0093ff            # cyan rune shade
  x #0099ff            # cyan rune
  z #009cff            # cyan rune mid
  w #00a5ff            # cyan rune bright
  g #825834            # dark brown page edge
  G #c4986d            # tan page mid
  t #d5b798            # light tan page
  o #e7d7c4            # page sheen

