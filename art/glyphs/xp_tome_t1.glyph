# Meridian — XP storage tome, Tier 1 (10 levels). Tiered xp tomes signal their
# tier through the COVER color (the largest, most legible surface): a muted,
# leather-weight tone rather than a neon one so it still reads as a book. T1 is
# the cool teal/cyan end of the cyan→crimson→gold ramp. Pages are neutral cream
# and the experience gem is a constant white socket across all tiers, so only
# the cover (chars A/B/P/p/s/q) changes between tomes.
size: 32
kind: sprite
ships: src/main/resources/assets/meridian/textures/item/tome/xp_tome_t1.png

legend:
  . transparent
  K ink         # #0a0a0a outermost outline
  A #0a2b31     # cover inner outline / gem seat
  B #0f3b44     # cover dark edge
  P #1f7d86     # cover face (muted teal)
  p #14555e     # cover shade
  s #0d3940     # cover deep shadow
  q diamond     # #4eeaed cover highlight rim
  g #7a6a4e     # dark page edge
  G #c2b495     # page mid
  L #ece2c8     # bright page
  o #fff7e8     # page / cover sheen (cream)
  1 bone        # #e8e0d4 white gem body
  2 ash         # #a89f93 gem shade
  3 #ffffff     # gem glint

