# Meridian — Prismatic Web (animated, 16x16 item icon). A radial spider web:
# eight strands anchored corner-to-corner and edge-to-edge through a central
# hub, bound by two concentric diamond rings. Palette is prismarine-iridescent
# — a teal/sage-green strand body (the prismarine-shard material) carrying a
# prismatic shimmer that sweeps the web in cyan and Meridian violet, the
# signature of its anvil curse-cleansing role. Crafted from prismarine shards +
# string.
size: 16
frametime: 5
kind: sprite
ships: src/main/resources/assets/meridian/textures/item/prismatic_web.png

legend:
  . transparent
  d #15514a            # deep teal — strand core shadow (prismarine dark)
  t #2a7d70            # teal midtone strand
  g #3fae97            # sage-teal base strand
  l #74d8bf            # light aqua highlight strand
  c #9bf2df            # cyan shimmer
  w #e6fff8            # bright glint — brightest shimmer core
  p #b87fe6            # light violet prismatic shimmer
  V meridian.purple    # violet accent node (#7b2fbe)
  C #4fe6e0            # cyan accent node

