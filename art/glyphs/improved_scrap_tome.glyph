# Meridian — Improved Scrap Tome. The dark navy/blue salvage book seen in
# isometric tilt, twin to scrap_tome. The crossed-bones "X" salvage rune on the
# cover glows light blue/cyan (the "improved" tell), and cream/bone page edges
# run along the bottom. Faithful trace of the shipped 32×32 item icon.
size: 32
kind: sprite
ships: src/main/resources/assets/meridian/textures/item/tome/improved_scrap_tome.png

legend:
  . transparent
  K #080A13           # near-black outermost outline
  A #111426           # navy outline / cover edge dark
  B #181C35           # dark navy edge
  C #1D2241           # navy shade
  D #212749           # navy mid-shadow
  E #21274C           # navy cover deep
  F #272E58           # navy cover face
  g #5E75C7           # cyan rune shade
  h #647BCD           # cyan rune mid
  i #677ED0           # cyan rune body / glow
  j #7087D9           # cyan rune highlight
  a #A6A08B           # bone page edge shadow
  o #C0BCAD           # bone page edge mid
  O #DBD9D0           # bone page sheen / highlight
  s #67614F           # dark page-edge corner

