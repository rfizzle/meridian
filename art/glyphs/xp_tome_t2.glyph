# Meridian — XP storage tome, Tier 2 (30 levels). Tier shown through the COVER
# color: a muted crimson — the cool/hot/warm midpoint of the cyan→crimson→gold
# ramp. Pages are neutral cream and the gem is a constant white socket, so only
# the cover (chars A/B/P/p/s/q) changes between tomes.
size: 32

legend:
  . transparent
  K ink         # #0a0a0a outermost outline
  A #2a0b10     # cover inner outline / gem seat
  B #3a0f16     # cover dark edge
  P #9e2a3e     # cover face (muted crimson)
  p #6b1c2a     # cover shade
  s #441218     # cover deep shadow
  q #f43b5e     # cover highlight rim
  g #7a6a4e     # dark page edge
  G #c2b495     # page mid
  L #ece2c8     # bright page
  o #fff7e8     # page / cover sheen (cream)
  1 bone        # #e8e0d4 white gem body
  2 ash         # #a89f93 gem shade
  3 #ffffff     # gem glint

