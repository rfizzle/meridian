# Meridian — Scrap (salvage) tome. Shares the suite tome silhouette in a dark
# navy/blue closed-book palette, set apart by a silvery-grey crossed-bones "X"
# salvage rune on the cover and cream/bone page edges along the bottom. Reads as
# "scrap / break down" at a glance.
size: 32
kind: sprite
ships: src/main/resources/assets/meridian/textures/item/tome/scrap_tome.png

legend:
  . transparent
  m #080A13            # near-black navy — outermost outline / deepest shadow
  K #111426            # dark navy outline
  i #181C35            # navy edge / inner shade
  a #1D2241            # navy cover shade
  c #212749            # navy cover mid-shade
  h #21274C            # navy cover highlight seat
  b #272E58            # navy cover face
  j #67614F            # muted olive page-shadow nub
  l #A6A08B            # bone page edge shadow
  k #C0BCAD            # bone page edge mid
  n #DBD9D0            # bone page edge bright
  e #878787            # grey rune shadow
  f #949494            # grey rune mid
  d #9A9A9A            # grey rune body
  g #AEAEAE            # grey rune highlight

