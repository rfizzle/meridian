# everfeast_baked_potato — the vanilla baked potato sprite, transmuted gold by
# the Everfeast infusion. Vanilla silhouette and shading structure kept so the
# base food stays recognizable; the ramp is re-hued onto the shared everfeast
# bronze->gold gradient, with a slow pulse that lifts the tones and crests a
# glint on the upper-left light edge. Family scheme: everfeast_cooked_beef.
size: 16
frametime: 6
interpolate: true

legend:
  . transparent
  A #452f04
  B #79550d
  C #8f6712
  D #9f7619
  E #b1841d
  F #be9122
  G #c29625
  H #d1a62e
  I #d3a930
  J #eec847
  a #4e3809
  b #876316
  c #9d761d
  d #ad8625
  e #be942a
  f #caa130
  g #cea533
  h #dbb33c
  i #ddb63d
  j #f2ce50
  W #fff0a8      # glint crest, near-white gold

