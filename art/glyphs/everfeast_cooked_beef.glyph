# everfeast_cooked_beef — the vanilla cooked-beef steak, transmuted gold by the
# Everfeast infusion. Same silhouette and shading structure as the vanilla
# sprite so the base food stays recognizable at a glance; the brown ramp is
# re-hued to a bronze->gold ramp, and a slow pulse breathes light through the
# midtones with a glint cresting along the upper-left light edge at the peak.
# Shared tone scheme for the whole everfeast ration family.
size: 16
frametime: 6
interpolate: true

legend:
  . transparent
  A #7a5410      # rim / form separator, deep bronze (vanilla dark outline)
  H #452f04      # occlusion shadow, underside
  I #62430a      # core shadow
  E #8a6210      # dark midtone
  G #a1781a      # shadow-side midtone
  B #b8891e      # midtone
  C #c99f2a      # warm midtone
  D #dcb135      # light midtone
  F #eec847      # highlight
  Z #d9b23c      # pulse: warm midtone, lifted
  Y #ecc44a      # pulse: light midtone, lifted
  X #fadd66      # pulse: highlight, lifted
  W #fff0a8      # glint crest, near-white gold

# frame 1 — base
frame:
  ................
  ................
  ................
  .........AAAA...
  ........ABCBDA..
  .......AEFDGBGA.
  ......ADDECDEBH.
  ....AAGEFDECBEH.
  ...AECDGEFDBGIH.
  ...ABEFDDEFGIH..
  ..ABCFEFDBEIIH..
  ..AFBCFEBCGIH...
  ...AFDDCGIIH....
  ...HHEIIIHH.....
  .....HHHH.......
  ................

