# Meridian — XP storage tome, Tier 3 (50 levels). Tier shown through the COVER
# color: warm gold (meridian.gold-deep face, meridian.gold rim) — the top of the
# cyan→crimson→gold ramp and the most on-brand. Pages are neutral cream and the
# gem is a constant white socket, so only the cover (A/B/P/p/s/q) changes.
size: 32

legend:
  . transparent
  K ink                # #0a0a0a outermost outline
  A #2e2408            # cover inner outline / gem seat
  B #4a3a0e            # cover dark edge
  P #b8860b            # cover face (deep gold)
  p #7a5a14            # cover shade
  s #4a3a0e            # cover deep shadow
  q meridian.gold      # #ffd700 cover highlight rim
  g #7a6a4e            # dark page edge
  G #c2b495            # page mid
  L #ece2c8            # bright page
  o #fff7e8            # page / cover sheen (cream)
  1 bone               # #e8e0d4 white gem body
  2 ash                # #a89f93 gem shade
  3 #ffffff            # gem glint

