# Meridian — Dormant XP tome (crafted, not yet activated). Same book silhouette
# as the activated xp tomes, but the cover is plain, uncharged leather — no tier
# color. Enchanting-table activation lights the cover to the tier color (T1 teal
# / T2 crimson / T3 gold). Pages are neutral cream; the gem is a constant white
# socket, matching the activated tomes so only the cover (A/B/P/p/s/q) differs.
size: 32

legend:
  . transparent
  K ink         # #0a0a0a outermost outline
  A #1a1712     # cover inner outline / gem seat
  B #2a2620     # cover dark edge
  P #5c5346     # cover face (uncharged leather)
  p #3e382e     # cover shade
  s #2a2620     # cover deep shadow
  q #8a8170     # dull cover rim (no glow)
  g #7a6a4e     # dark page edge
  G #c2b495     # page mid
  L #ece2c8     # bright page
  o #fff7e8     # page / cover sheen (cream)
  1 bone        # #e8e0d4 white gem body
  2 ash         # #a89f93 gem shade
  3 #ffffff     # gem glint

