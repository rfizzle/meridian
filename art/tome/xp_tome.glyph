# Meridian — XP (experience) tome. Shares the suite tome silhouette but wears the
# mod's identity colors so it reads as "experience" at a glance, no label needed:
# a Meridian-purple cover with gold page edges and a glowing gold experience orb.
size: 32

legend:
  . transparent
  K ink                # #0a0a0a outermost outline
  A #1a0a2e            # deep purple-ink, inner outline / orb seat
  B #2e1248            # dark purple edge
  P meridian.purple    # #7b2fbe cover face
  p #5a2090            # cover shade
  s #3a1660            # cover deep shadow / page shadow
  q #9d5fd3            # purple glow halo / highlight rim
  g #8a6d2e            # dark gold page edge
  G meridian.gold-deep # #daa520 gold page mid / orb shadow side
  L meridian.gold      # #ffd700 bright gold page / orb body
  o bone               # #e8e0d4 page sheen / orb glint

