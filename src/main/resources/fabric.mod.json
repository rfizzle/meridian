{
    "schemaVersion": 1,
    "id": "meridian",
    "version": "${version}",
    "name": "Meridian",
    "description": "Zenith-style enchanting overhaul — stat-driven shelves, anvil tweaks, library storage, and tomes.",
    "authors": ["rfizzle"],
    "contact": {
        "homepage": "https://meridian.rfizzle.com",
        "sources": "https://github.com/rfizzle/meridian",
        "issues": "https://github.com/rfizzle/meridian/issues"
    },
    "license": "MIT",
    "icon": "assets/meridian/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": ["com.rfizzle.meridian.Meridian"],
        "client": ["com.rfizzle.meridian.client.MeridianClient"],
        "fabric-datagen": ["com.rfizzle.meridian.data.MeridianDataGenerator"],
        "emi": ["com.rfizzle.meridian.compat.emi.EmiEnchantingPlugin"],
        "rei_client": ["com.rfizzle.meridian.compat.rei.ReiEnchantingPlugin"],
        "jei_mod_plugin": ["com.rfizzle.meridian.compat.jei.JeiEnchantingPlugin"],
        "jade": ["com.rfizzle.meridian.compat.jade.JadeEnchantingPlugin"],
        "modmenu": ["com.rfizzle.meridian.compat.modmenu.ModMenuIntegration"]
    },
    "accessWidener": "meridian.accesswidener",
    "mixins": [
        "meridian.mixins.json",
        {
            "config": "meridian.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.16.10",
        "minecraft": "~1.21.1",
        "java": ">=21",
        "fabric-api": "*"
    },
    "suggests": {
        "tribulation": "*",
        "emi": "*",
        "roughlyenoughitems": "*",
        "jei": "*",
        "jade": "*",
        "wthit": "*",
        "modmenu": "*"
    }
}
