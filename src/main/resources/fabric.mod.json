{
    "schemaVersion": 1,
    "id": "meridian",
    "version": "${version}",
    "name": "Meridian",
    "description": "Zenith-style enchanting overhaul — stat-driven shelves, anvil tweaks, library storage, and tomes.",
    "authors": ["rfizzle"],
    "contact": {
        "homepage": "https://meridian.rfizzle.com",
        "sources": "https://github.com/rfizzle/meridian",
        "issues": "https://github.com/rfizzle/meridian/issues"
    },
    "license": "MIT",
    "icon": "assets/meridian/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": ["com.rfizzle.meridian.Meridian"],
        "client": ["com.rfizzle.meridian.client.MeridianClient"],
        "fabric-datagen": ["com.rfizzle.meridian.data.MeridianDataGenerator"],
        "fabric-gametest": [
            "com.rfizzle.meridian.gametest.RegistryGameTest",
            "com.rfizzle.meridian.gametest.ShelfRosterGameTest",
            "com.rfizzle.meridian.enchanting.FilteringTreasureGameTest",
            "com.rfizzle.meridian.gametest.ShelfScanGameTest",
            "com.rfizzle.meridian.gametest.MenuEndToEndGameTest",
            "com.rfizzle.meridian.gametest.PrismaticWebGameTest",
            "com.rfizzle.meridian.gametest.LibraryGameTest",
            "com.rfizzle.meridian.gametest.LibraryQueryApiGameTest",
            "com.rfizzle.meridian.gametest.LootEnchantApiGameTest",
            "com.rfizzle.meridian.gametest.TomeRegistryGameTest",
            "com.rfizzle.meridian.gametest.TomeAnvilGameTest",
            "com.rfizzle.meridian.gametest.XpTomeGameTest",
            "com.rfizzle.meridian.gametest.CraftingButtonGameTest",
            "com.rfizzle.meridian.gametest.SpecialtyMaterialsGameTest",
            "com.rfizzle.meridian.gametest.AdvancementCodecGameTest",
            "com.rfizzle.meridian.gametest.TomeRecipeClassifierGameTest",
            "com.rfizzle.meridian.gametest.StatRegistryGameTest",
            "com.rfizzle.meridian.gametest.AnvilRepairGameTest",
            "com.rfizzle.meridian.gametest.LibraryPersistGameTest",
            "com.rfizzle.meridian.gametest.LibraryHopperGameTest",
            "com.rfizzle.meridian.gametest.ModSentinelGameTest",
            "com.rfizzle.meridian.gametest.ConfigReloadGameTest",
            "com.rfizzle.meridian.gametest.ReloadCallbackGameTest",
            "com.rfizzle.meridian.gametest.enchantments.EnchantmentRosterIntegrationTest",
            "com.rfizzle.meridian.gametest.enchantments.ExclusiveSetEnforcementTest",
            "com.rfizzle.meridian.gametest.enchantments.ConfigDisableEnchantmentTest",
            "com.rfizzle.meridian.gametest.enchantments.AttributeEnchantmentEffectTest",
            "com.rfizzle.meridian.gametest.enchantments.StatusEffectEnchantmentTest",
            "com.rfizzle.meridian.gametest.enchantments.EdgeCaseEnchantmentTest",
            "com.rfizzle.meridian.gametest.enchantments.MechanicsEnchantmentTest",
            "com.rfizzle.meridian.gametest.enchantments.AttributeAndProtectionTest",
            "com.rfizzle.meridian.gametest.enchantments.DefinitionVerificationTest",
            "com.rfizzle.meridian.gametest.enchantments.MobEquipmentTagTest",
            "com.rfizzle.meridian.gametest.EnchantmentSelectionGameTest",
            "com.rfizzle.meridian.gametest.EnchantmentTagGameTest",
            "com.rfizzle.meridian.gametest.RarityTagGameTest",
            "com.rfizzle.meridian.event.ArmorTickHandlerGameTest",
            "com.rfizzle.meridian.event.ProjectileEnchantmentHandlerGameTest",
            "com.rfizzle.meridian.event.AurifyHandlerGameTest",
            "com.rfizzle.meridian.event.MountedEnchantmentHandlerGameTest",
            "com.rfizzle.meridian.event.TetherHandlerGameTest"
        ],
        "emi": ["com.rfizzle.meridian.compat.emi.EmiEnchantingPlugin"],
        "rei_client": ["com.rfizzle.meridian.compat.rei.ReiEnchantingPlugin"],
        "jei_mod_plugin": ["com.rfizzle.meridian.compat.jei.JeiEnchantingPlugin"],
        "jade": ["com.rfizzle.meridian.compat.jade.JadeEnchantingPlugin"],
        "modmenu": ["com.rfizzle.meridian.compat.modmenu.ModMenuIntegration"]
    },
    "accessWidener": "meridian.accesswidener",
    "mixins": [
        "meridian.mixins.json",
        {
            "config": "meridian.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.16.10",
        "minecraft": "1.21.1",
        "java": ">=21",
        "fabric-api": ">=0.116.1"
    },
    "suggests": {
        "emi": "*",
        "roughlyenoughitems": "*",
        "jei": "*",
        "jade": "*",
        "wthit": "*",
        "modmenu": "*"
    }
